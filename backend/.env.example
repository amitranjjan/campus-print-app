# ==========================================
# Supabase Configuration (Database & Storage)
# ==========================================
# Project URL from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# Service Role Key (recommended for backend) or Anon Key from Project Settings -> API
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Storage Bucket for print job PDFs (default: print-jobs)
SUPABASE_STORAGE_BUCKET=print-jobs

# ==========================================
# Firebase Admin Credentials (Authentication)
# ==========================================
# Option A: Path to service account json file (for local development)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Option B: Inline JSON string or Base64 (Recommended for Render, Railway, Fly.io, Vercel deployments)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# Firebase Storage Bucket (optional)
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app

# Comma-separated list of Shopkeeper / Admin email addresses
ADMIN_EMAILS=admin@campus.edu,xeroxshop@campus.edu

# Razorpay API Credentials
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YYYYYYYYYYYYYYYYYYYYYYYY

