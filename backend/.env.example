# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=CampusXerox

# Firebase Admin Credentials
# Option A: Path to service account json file (for local development)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Option B: Inline JSON string or Base64 (Recommended for Render, Railway, Fly.io, Vercel deployments)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# Firebase Storage Bucket (optional)
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app

# Comma-separated list of Shopkeeper / Admin email addresses
ADMIN_EMAILS=admin@campus.edu,xeroxshop@campus.edu

# Razorpay API Credentials
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YYYYYYYYYYYYYYYYYYYYYYYY

